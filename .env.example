# Copy this file to .env (same folder as docker-compose.yml), fill it in, then run:
#   docker compose up -d api
#
# Mailtrap: open your inbox > Integration > SMTP and copy its Host, Port, Username and Password.
# Leave MAIL_HOST empty to have emails written to the API log instead of sent.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Bookly <no-reply@bookly.test>

# The website the links in emails open.
APP_FRONTEND_URL=http://localhost:5173
